  },
  "tokens": {
    "colors": {
      "primary": "#E05A2B",
      "primaryHover": "#C84B1F",
      "secondary": "#1A1A1A",
      "secondaryHover": "#2D2D2D",
      "button": "#E05A2B",
      "buttonText": "#FFFFFF",
      "buttonHover": "#C84B1F",
      "card": "#1E222B",
      "background": "#0D0F12",
      "surface": "#16191F",
      "surfaceCard": "#1E222B",
      "surfaceHover": "#272C38",
      "text": "#F8FAFC",
